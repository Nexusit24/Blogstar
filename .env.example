# Bangla SEO AI Writer Pro - Environment Configuration
# NOTE: Any variable starting with VITE_ will be bundled into client-side JS
# and visible to anyone inspecting browser network/sources.

# Optional default xKiro API Key (Recommended to let users configure in Settings UI)
VITE_XKIRO_API_KEY=

# Optional AI API base URL (Default: https://api.xkiro.com/v1)
VITE_XKIRO_BASE_URL=https://api.xkiro.com/v1
